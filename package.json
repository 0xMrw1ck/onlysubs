{
  "name": "onlysubs",
  "version": "0.6.0",
  "author": "WickWorks <jakenftwick@gmail.com>",
  "description": "onlysubs — a clipping tool for everyone",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "web": "vite",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build": "vite build && node scripts/notices.mjs && electron-builder --win nsis --x64 --publish never",
    "build:site": "node scripts/build-site.mjs",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.localreelstudio.app",
    "productName": "onlysubs",
    "directories": {
      "output": "work/windows-build"
    },
    "artifactName": "onlysubs-${version}-setup-${arch}.${ext}",
    "compression": "store",
    "publish": [{"provider":"github","owner":"0xMrw1ck","repo":"onlysubs-updates"}],
    "nsis": {"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":true,"deleteAppDataOnUninstall":false},
    "extraFiles": [
      {
        "from": "work/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "extraResources": [
      {
        "from": "work/engines",
        "to": "engines"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "server/transcribe.py"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/onlysubs-logo.png",
      "signExecutable": false
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "vite": "8.2.2",
    "wait-on": "8.0.2"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "allowScripts": {
    "electron@44.2.0": true
  }
}
